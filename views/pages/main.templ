package pages

import "github.com/alxxdev/gonews/views/components"
import "github.com/alxxdev/gonews/views/layout"

type MainProps struct {
    Tags []components.Tag
}

templ Main(props MainProps) {
    @layout.Layout(layout.LayoutProps{
        Title: "Новости | Главная",
        MetaDescription: "Актуальные новости",
    }) {
        @layout.Header()
        @components.TagList(components.TagListProps{Tags: props.Tags})
        @layout.Footer()
    }
}